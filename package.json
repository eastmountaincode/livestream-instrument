{
  "name": "live-stream-instrument",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "r2:bucket:create": "wrangler r2 bucket create resonator-stream-review",
    "r2:bucket:list": "wrangler r2 bucket list",
    "r2:seed": "curl -s http://localhost:3000/api/stream-candidates | node -e \"let data='';process.stdin.on('data',d=>data+=d);process.stdin.on('end',()=>process.stdout.write(JSON.stringify(JSON.parse(data).candidates,null,2)))\" | wrangler r2 object put resonator-stream-review/stream-candidates.json --pipe --content-type application/json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@tailwindcss/postcss": "^4.2.2",
    "hls.js": "^1.6.15",
    "next": "^16.2.2",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/webmidi": "^2.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "wrangler": "^4.85.0"
  }
}
